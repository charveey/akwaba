# ==== PostgreSQL (utilisé par le conteneur postgres) ====
POSTGRES_USER=akwaba
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=akwaba

# ==== Backend ====
DATABASE_URL=postgresql+psycopg://akwaba:CHANGE_ME@postgres:5432/akwaba
SECRET_KEY=
FIELD_ENCRYPTION_KEY=
LOG_LEVEL=INFO
ENABLE_DOCS=false

# ==== Exposition (tailnet uniquement) ====
# IP Tailscale du serveur : le conteneur web n'écoute QUE sur cette IP.
TAILNET_BIND_IP=100.126.200.88
WEB_PORT=8080
# IP(s) Tailscale autorisées pour /api/agent/ (Exit Node), séparées par des virgules.
AGENT_ALLOWED_IPS=100.85.214.5
# Cookie de session : Secure obligatoire (admin servi en HTTPS via tailscale serve).
COOKIE_SECURE=true

# ==== Tailscale REST (lecture seule : /users et /devices) ====
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=

# ==== Mode V1 : OBSERVATION UNIQUEMENT ====
REVOCATION_MODE=dry_run
ENFORCER_ENABLED=false

# ==== Règles métier ====
UNKNOWN_USER_GRACE_PERIOD_HOURS=24
DEFAULT_GRACE_PERIOD_DAYS=3
RENEWAL_IN_GRACE_START=PREVIOUS_EXPIRY
DEFAULT_CURRENCY=XOF
