# ==== PostgreSQL (utilisé par le conteneur postgres) ====
POSTGRES_USER=akwaba
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=akwaba

# ==== Backend ====
DATABASE_URL=postgresql+psycopg://akwaba:CHANGE_ME@postgres:5432/akwaba
SECRET_KEY=
FIELD_ENCRYPTION_KEY=
LOG_LEVEL=INFO
ENABLE_DOCS=false

# ==== Exposition (tailnet uniquement, aucun port public) ====
# Deux points d'entrée distincts :
#
#  1. Backend, pour l'AGENT de l'Exit Node (connexion directe, HMAC + liste d'IP) :
#       ${TAILNET_BIND_IP}:8000  (et 127.0.0.1:8000 pour l'administration locale)
#     TAILNET_BIND_IP = IP Tailscale du serveur.
#
#  2. Nginx (web), pour l'interface d'ADMINISTRATION :
#       127.0.0.1:8080, fixé dans docker-compose.yml (jamais une IP publique ni tailnet),
#       exposé en HTTPS sur le tailnet par : tailscale serve --https=8443 → 127.0.0.1:8080
#       (voir deploy/tailscale/serve-8443.sh ; le Funnel existant sur 443 n'est pas modifié).
TAILNET_BIND_IP=100.126.200.88
# IP(s) Tailscale autorisées pour /api/agent/ (Exit Node), séparées par des virgules.
AGENT_ALLOWED_IPS=100.85.214.5
# Cookie de session : Secure obligatoire (admin servi en HTTPS via tailscale serve).
# Le cookie est aussi HttpOnly et SameSite=Strict.
COOKIE_SECURE=true
# OBLIGATOIRE : origine(s) HTTPS exacte(s) de l'interface d'administration, séparées
# par des virgules, sans chemin ni barre finale. Toute requête mutative (hors
# /api/agent/) dont l'Origin (ou, à défaut, le Referer) n'est pas dans cette liste
# est refusée (403) ; une requête sans Origin ni Referer aussi.
ALLOWED_ORIGINS=https://ubuntu.tail14614.ts.net:8443
# TRUSTED_PROXY_IPS est fixé dans docker-compose.yml (= IP de Nginx, 10.250.11.10).

# ==== Tailscale REST (lecture seule : /users et /devices) ====
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=

# ==== Mode V1 : OBSERVATION UNIQUEMENT ====
REVOCATION_MODE=dry_run
ENFORCER_ENABLED=false

# ==== Règles métier ====
UNKNOWN_USER_GRACE_PERIOD_HOURS=24
DEFAULT_GRACE_PERIOD_DAYS=3
RENEWAL_IN_GRACE_START=PREVIOUS_EXPIRY
DEFAULT_CURRENCY=XOF

RECONCILER_ENABLED=false
RECONCILER_INTERVAL_SECONDS=60

PURGE_ENABLED=false
PURGE_INTERVAL_SECONDS=3600
PURGE_BATCH_SIZE=5000
RETENTION_HEARTBEATS_DAYS=30
RETENTION_JOB_RUNS_DAYS=30
RETENTION_OBSERVATIONS_DAYS=90
RETENTION_SESSIONS_DAYS=365
