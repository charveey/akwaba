[Unit]
Description=Akwaba VPN - agent d'observation (lecture seule, aucun blocage)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=akwaba-agent
Group=akwaba-agent
WorkingDirectory=/opt/akwaba-agent
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m akwaba_agent --config /etc/akwaba-agent/agent.ini
StateDirectory=akwaba-agent
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
MemoryMax=96M
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
# Volontairement absents : ProtectKernelModules, RestrictRealtime, LockPersonality (et NoNewPrivileges).
# Mesuré sur ce Pi : chacun empêche sudo d'obtenir uid 0, donc conntrack échoue.

[Install]
WantedBy=multi-user.target
