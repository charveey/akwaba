{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Akwaba : préparer l'environnement (une fois)",
      "type": "shell",
      "command": "${workspaceFolder}/tests/setup-dev.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Akwaba : tous les tests",
      "type": "shell",
      "command": "${workspaceFolder}/tests/run.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Akwaba : tests rapides (sans bout en bout)",
      "type": "shell",
      "command": "${workspaceFolder}/tests/run-all.sh",
      "args": [
        "--rapide"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Akwaba : tests du fichier courant",
      "type": "shell",
      "command": "${workspaceFolder}/tests/run.sh",
      "args": [
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Akwaba : test sélectionné (nom du test ou de la classe)",
      "type": "shell",
      "command": "${workspaceFolder}/tests/run.sh",
      "args": [
        "${file}",
        "-k",
        "${selectedText}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Akwaba : tests frontend",
      "type": "shell",
      "command": "${workspaceFolder}/tests/run.sh",
      "args": [
        "${workspaceFolder}/frontend"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Akwaba : base de test — démarrer",
      "type": "shell",
      "command": "${workspaceFolder}/tests/test-db.sh",
      "args": [
        "up"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Akwaba : base de test — arrêter",
      "type": "shell",
      "command": "${workspaceFolder}/tests/test-db.sh",
      "args": [
        "down"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Akwaba : couverture du fichier courant",
      "type": "shell",
      "command": "${workspaceFolder}/tests/run.sh",
      "args": [
        "--couverture",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Akwaba : couverture complète (backend, agent, frontend)",
      "type": "shell",
      "command": "${workspaceFolder}/tests/run.sh --couverture ${workspaceFolder}/backend && ${workspaceFolder}/tests/run.sh --couverture ${workspaceFolder}/agent && ${workspaceFolder}/tests/run.sh --couverture ${workspaceFolder}/frontend",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
